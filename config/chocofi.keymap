#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/36.h"

#define BASE        0
#define NAV         1
#define SYM         2
#define NUM         3
#define FN          4
#define CASE_UNDER  5
#define CASE_SLASH  6

#define XXX &none
#define ___ &trans
#define QUICK_TAP_MS 75

&sk {
  release-after-ms = <900>;
  quick-release;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <QUICK_TAP_MS>;
};

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2 // Thumbs on 36+ keys.

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <150>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

// Hack: Make HRM combos tap-only (cf, ZMK issue #544).
#define ZMK_COMBO_8(NAME, TAP, POS, LAYERS, COMBO_MS, IDLE_MS, HOLD, SIDE)     \
  MAKE_HRM(hm_combo_##NAME, &kp, TAP, SIDE THUMBS)                             \
  ZMK_COMBO_6(NAME, &hm_combo_##NAME HOLD 0, POS, LAYERS, COMBO_MS, IDLE_MS)

#include "keycodes.dtsi"
#include "autolayer.dtsi"
#include "combos.dtsi"

/* Keymap */
ZMK_CONDITIONAL_LAYER(sys, NAV SYM, FN) // NAV + SYM --> FN.

#ifndef ZMK_BASE_LAYER
  #define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                 \
      ZMK_LAYER(name, LT RT LM RM LB RB LH RH)
#endif

ZMK_BASE_LAYER(Base,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp Q         &kp W            &kp E            &kp R            &kp T          ,   &kp Y            &kp U            &kp I            &kp O            &kp P          ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &hml LALT A   &hml LCTRL S     &hml LGUI D      &hml LSHFT F     &kp G          ,   &kp H            &hmr RSHFT J     &hmr LGUI K      &hmr LCTRL L     &hmr LALT SQT  ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp Z         &kp X            &kp C            &kp V            &kp B          ,   &kp N            &kp M            &comma_morph     &dot_morph       &qexcl         ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   &sl NUM          &kp SPACE        &mo NAV        ,   &mo SYM          &kp RET          &kp BSPC
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)

ZMK_BASE_LAYER(Nav,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp ESC       CASE_PATH        CASE_CAPS        NUM_WORD         &kp TAB        ,   SCREENSHOT       SEL_WB           NAV_UP           SEL_WF           NAV_DEL        ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp LALT      &kp LCTRL        &kp LGUI         &kp LSHFT        &kp LS(TAB)    ,   LAUNCHER         NAV_LEFT         NAV_DOWN         NAV_RIGHT        &kp RET        ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    SAVE          CUT_             COPY_            PASTE            UNDO_          ,   REDO             SEL_LB           CMNT             SEL_LF           NAV_BSPC       ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   ___              ___              ___            ,   ___              ___              ___
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)

ZMK_BASE_LAYER(Sym,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp ESC       &bracket         &brace           &paren           &kp TILDE      ,   &kp GRAVE        &kp RPAR         &kp RBRC         &kp RBKT         NAV_DEL        ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp MIN       &kp ASTRK        &kp EQUAL        &kp UNDER        &kp DLLR       ,   &kp HASH         &kp LSHFT        &kp LGUI         &kp LCTRL        &kp LALT       ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp PLUS      &kp PIPE         &kp AT           &kp FSLH         &kp PRCNT      ,   &js_fn           &kp BSLH         &kp AMPS         &dbl_arrow       &sgl_arrow     ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   &kp BSPC         ___              ___            ,   ___              ___              ___
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)

ZMK_BASE_LAYER(Num,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp N1        &kp N2           &kp N3           &kp N4           &kp N5         ,   &kp N6           &kp N7           &kp N8           &kp N9           &kp N0         ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &hml LALT MIN &hml LCTRL ASTRK &hml LGUI EQUAL  &hml LSHFT FSLH  &kp DLLR       ,   &kp K_CANCEL     &kp LSHFT        &kp LGUI         &kp LCTRL        &kp LALT       ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    ___           &kp HASH         &kp PLUS         &kp FSLH         ___            ,   ___              ___              &kp COMMA        &kp DOT          ___            ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   &sl NUM          ___              ___            ,   ___              ___              ___
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)

ZMK_BASE_LAYER(Fn,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp F12       &kp F7           &kp F8           &kp F9           &bootloader    ,   &studio_unlock   &kp C_PREV       &kp VUP          &kp C_NEXT       &kp C_PP       ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &hml LALT F11 &hml LCTRL F4    &hml LGUI F5     &hml LSHFT F6    SWAP           ,   &kp LS(TAB)      &hmr RSHFT PUP   &hmr LGUI VDN    &hmr LCTRL PDN   &hmr LALT BRK  ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp F10       &kp F1           &kp F2           &kp F3           &kp K_CANCEL   ,   ___              ___              &kp C_MUTE       ___              ___            ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   ___              ___              ___            ,   ___              ___              ___
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)

ZMK_BASE_LAYER(Casemode_Under,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp Q         &kp W            &kp E            &kp R            &kp T          ,   &kp Y            &kp U            &kp I            &kp O            &kp P          ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &hml LALT A   &hml LCTRL S     &hml LGUI D      &hml LSHFT F     &kp G          ,   &kp H            &hmr RSHFT J     &hmr LGUI K      &hmr LCTRL L     &hmr LALT SQT  ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp Z         &kp X            &kp C            &kp V            &kp B          ,   &kp N            &kp M            &comma_morph     &dot_morph       &qexcl         ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   &kp K_CANCEL     &kp UNDER        &kp K_CANCEL   ,   &mo SYM          &kp RET          &kp BSPC
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)

ZMK_BASE_LAYER(Casemode_Under,
//╭─────────────┬────────────────┬────────────────┬────────────────┬────────────────╮ ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
    &kp Q         &kp W            &kp E            &kp R            &kp T          ,   &kp Y            &kp U            &kp I            &kp O            &kp P          ,
//├─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &hml LALT A   &hml LCTRL S     &hml LGUI D      &hml LSHFT F     &kp G          ,   &kp H            &hmr RSHFT J     &hmr LGUI K      &hmr LCTRL L     &hmr LALT SQT  ,
//|─────────────┼────────────────┼────────────────┼────────────────┼────────────────┤ ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
    &kp Z         &kp X            &kp C            &kp V            &kp B          ,   &kp N            &kp M            &comma_morph     &dot_morph       &qexcl         ,
//╰─────────────┴────────────────┴────────────────┼────────────────┴────────────────┤ ├────────────────┼────────────────┴────────────────┼────────────────┴────────────────╯
                                   &kp K_CANCEL     &kp SLASH        &kp K_CANCEL   ,   &mo SYM          &kp RET          &kp BSPC
//                               ╰────────────────┴────────────────┴────────────────╯ ╰────────────────┴────────────────┴────────────────╯
)
